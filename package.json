{
  "name": "ai-insight-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "eval": "node tests/eval.mjs",
    "check": "node --check dist/app.js && node --check dist/real-data.js && node --check server/application.mjs && node --check server/rag.mjs",
